# Image generation provider: "openai" (default) or "demo" (no API calls, local mockup only)
IMAGE_PROVIDER=openai

# OpenAI API key (used when IMAGE_PROVIDER=openai)
OPENAI_API_KEY=sk-...

# Optional overrides
# Image model. Left unset, the app uses the newest model your key can reach (gpt-image-2.5-sunburst) and steps down
# to older ones only if the API rejects a request. Newer models are far better at lettering and at keeping logos intact.
# OPENAI_IMAGE_MODEL=gpt-image-2.5-sunburst
OPENAI_IMAGE_SIZE=1024x1024
# high is the default: lettering accuracy drops noticeably at medium
OPENAI_IMAGE_QUALITY=medium
# How many reference coin photos from ./references to send with each render (0 to disable, 3 at most).
# Two is plenty to set the style; more only adds other coins' lettering for the model to confuse with the customer's.
REFERENCE_COUNT=2
# Proofreading: every render is read back letter by letter and compared with what the customer typed.
# If it is wrong, the coin is rendered again with a note about what to fix, up to AI_MAX_ATTEMPTS renders in total (1-3).
# AI_VERIFY=0 turns proofreading off (renders are then shown without a checked / needs-a-look badge).
AI_MAX_ATTEMPTS=2
# OPENAI_VERIFY_MODEL=gpt-5.4-mini
# On the quote step the finished design is read by the same vision model, so the estimate starts from what the coin
# actually shows (metal finish, color on which sides, two-tone plating, edge, keychain...) with a reason for each.
# AI_READ_DESIGN=0 turns that off: the form then guesses the finish from the style notes and nothing else is pre-selected.
# AI_READ_DESIGN=0
# Clean (unwatermarked) renders are kept in ./renders only so an order or design email can use them, then deleted after this many days
RENDER_KEEP_DAYS=3

# Server
PORT=3000
# Where ./orders, ./leads and ./renders are kept. Defaults to the app folder.
# On Render (or any host that wipes the app folder on deploy), point this at a persistent disk.
# DATA_DIR=/var/data

# ---- Protecting the OpenAI bill ----
# Every AI render costs money (roughly 10-20 cents) whether or not the visitor orders, so renders are capped.
# Per visitor (IP address): renders allowed per hour and per day
RENDERS_PER_HOUR=10
RENDERS_PER_DAY=25
# Whole site, per day (ET). When it is spent, rendering pauses until midnight and the team is emailed
# (at 80% and again at 100%, to ORDER_NOTIFY_TO). 300 renders is roughly $30-60 of OpenAI usage.
RENDERS_PER_DAY_TOTAL=300
# Optional but recommended: Cloudflare Turnstile (free) makes every render prove it came from a real browser,
# which stops scripts that rotate IP addresses. Create a widget at dash.cloudflare.com -> Turnstile, "invisible" type.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...
# Order submissions per IP per hour
ORDER_LIMIT_PER_HOUR=20

# ---- Ordering ----
# Quotes come from the price chart in lib/price-chart.json (made from the "Expanded Pricing Chart" spreadsheet with
# scripts/import-pricing.py). PRICING=0 turns the estimate off: no prices are shown and orders are saved as quote requests.
# PRICING=0
# Stripe secret key enables "Pay Now" via Stripe Checkout: the customer is charged the quoted total, line by line
# STRIPE_SECRET_KEY=sk_live_...
# Public URL of the deployed app (no trailing slash). Set this in production: it goes into the share-preview tags,
# canonical link, sitemap, Stripe return links and the "Order your coins" button in design emails.
# Without it the server uses whatever address each request came in on.
# PUBLIC_URL=https://coins.example.com
# Every order is emailed (with the artwork attached) to these addresses, using the same Brevo / SMTP setup as below.
# Set to an empty value to turn the order emails off.
# ORDER_NOTIFY_TO=bart@primarydm.com,chris@coinsforanything.com,jeff@coinsforanything.com
# Optional: every order is POSTed as JSON to this URL (Zapier, Make, Zoho Flow, etc.)
# ORDER_WEBHOOK_URL=https://hooks.zapier.com/...

# ---- Zoho CRM ----
# Every quote request becomes a Lead in Zoho CRM, with the coin described and the render attached (lib/zoho.js).
# Make a Self Client at https://api-console.zoho.com, generate a grant code with the scopes
# ZohoCRM.modules.leads.CREATE,ZohoCRM.modules.attachments.CREATE and run, within ten minutes:
#   node scripts/zoho-token.js <client id> <client secret> <grant code>
# It prints these three lines. Leave them unset and no lead is created.
# ZOHO_CLIENT_ID=1000.XXXX
# ZOHO_CLIENT_SECRET=...
# ZOHO_REFRESH_TOKEN=1000.XXXX.XXXX
# Only for organizations outside the US data center: https://accounts.zoho.eu, .in, .com.au, .jp
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com
# The Lead Source stamped on these leads
# ZOHO_LEAD_SOURCE=Coin Builder
# The sales reps' CRM user ids, comma separated. The leads are dealt out to them in turn (round robin). Leave it
# unset and every lead belongs to whoever made the Self Client.
# ZOHO_OWNERS=1613691000007708001,1613691000000228013,1613691000000228007

# ---- Emailing designs ----
# With SMTP set, "Email Me This Design" sends the customer their watermarked design and saves them as a lead in ./leads.
# Without it, the button still collects the address but falls back to a watermarked download.
# Simplest: a Brevo API key (Brevo > Settings > SMTP & API > API Keys). MAIL_FROM must be a verified sender in Brevo,
# and PUBLIC_URL must be set so the email can show the design (without it the design is only attached).
# BREVO_API_KEY=xkeysib-...
# Or any SMTP account instead. For Brevo SMTP the login is the one shown under SMTP (not your sign-in email)
# and the password is an SMTP key.
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=xxxxxxx@smtp-brevo.com
# SMTP_PASS=your-brevo-smtp-key
# MAIL_FROM="Coins for Anything <designs@coinsforanything.com>"
# Replies go here (for example the sales inbox); defaults to the From address
# MAIL_REPLY_TO=sales@coinsforanything.com
# Emails one visitor can trigger per hour (each address can also only be mailed 3 times an hour)
# MAIL_LIMIT_PER_HOUR=6
# Everyone who asks for a design by email is also added to ./leads/signups.csv. Staff can download that list at
# /signups.csv?key=ADMIN_KEY once this is set (pick something long and random)
# ADMIN_KEY=change-me-to-a-long-random-string
# Optional: every lead is also POSTed as JSON to this URL (Zapier, Make, Zoho Flow -> CRM)
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/...
# Testing: write each email to a .eml file in this folder instead of sending it
# MAIL_PREVIEW_DIR=./mail-preview

# ---- Testing ----
# TEST_MODE=1 puts the whole app in test mode: no coin is rendered (a placeholder is shown),
# orders are saved as TEST- orders, and Stripe / the webhook are never called.
# Without it, staff can open http://localhost:3000/?test=1 to test in one browser tab only.
# TEST_MODE=1
